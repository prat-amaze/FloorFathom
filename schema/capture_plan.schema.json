{
  "$defs": {
    "Diagnostics": {
      "properties": {
        "frames_used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "depth frames (lidar) or keyframes (video); not used for photos",
          "title": "Frames Used"
        },
        "points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "floor_height_world": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Height World"
        },
        "floor_sharpness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fraction of all points inside the floor spike",
          "title": "Floor Sharpness"
        },
        "bootstrap_replicates": {
          "title": "Bootstrap Replicates",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "conventions": {
          "title": "Conventions",
          "type": "string"
        },
        "models": {
          "description": "pretrained models used, as id@revision",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "scale_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how metric scale was obtained, e.g. lidar_metric, reference_object, monocular_depth",
          "title": "Scale Method"
        },
        "scale_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metres per unit of the reconstruction, when there is one",
          "title": "Scale Factor"
        },
        "scale_rel_sigma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "standard error of the scale as a fraction of it",
          "title": "Scale Rel Sigma"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "bootstrap_replicates",
        "seed",
        "seconds",
        "conventions"
      ],
      "title": "Diagnostics",
      "type": "object"
    },
    "Link": {
      "description": "Which room a doorway opens onto.",
      "properties": {
        "room": {
          "title": "Room",
          "type": "string"
        },
        "opening": {
          "title": "Opening",
          "type": "string"
        },
        "other": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the room behind the doorway; null if none is within 1.5 m (outside, or not captured)",
          "title": "Other"
        },
        "gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "metres from the doorway to the other room's outline; a wall thickness is a real link",
          "title": "Gap"
        },
        "mutual": {
          "description": "the other room has a doorway of its own next to this one",
          "title": "Mutual",
          "type": "boolean"
        }
      },
      "required": [
        "room",
        "opening",
        "other",
        "gap",
        "mutual"
      ],
      "title": "Link",
      "type": "object"
    },
    "Measurement": {
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lo"
        },
        "hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hi"
        },
        "unit": {
          "enum": [
            "m",
            "m2"
          ],
          "title": "Unit",
          "type": "string"
        },
        "method": {
          "description": "how the number was obtained",
          "title": "Method",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "lo",
        "hi",
        "unit",
        "method"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Opening": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "doorway",
          "title": "Kind",
          "type": "string"
        },
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "centre": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Centre",
          "type": "array"
        },
        "width": {
          "$ref": "#/$defs/Measurement"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "kind",
        "wall_id",
        "start",
        "end",
        "centre",
        "width"
      ],
      "title": "Opening",
      "type": "object"
    },
    "Overlap": {
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "area": {
          "description": "m2 of floor both rooms claim",
          "title": "Area",
          "type": "number"
        }
      },
      "required": [
        "a",
        "b",
        "area"
      ],
      "title": "Overlap",
      "type": "object"
    },
    "Placement": {
      "description": "How a room in its own frame was moved into the shared frame, by gluing doorways.",
      "properties": {
        "room": {
          "title": "Room",
          "type": "string"
        },
        "angle": {
          "description": "radians counter-clockwise, about the room's own origin, applied before the shift",
          "title": "Angle",
          "type": "number"
        },
        "shift": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Shift",
          "type": "array"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the placed room this one hangs off; null for the root",
          "title": "Host"
        },
        "host_opening": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Host Opening"
        },
        "opening": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "this room's doorway that meets the host's",
          "title": "Opening"
        },
        "overlap": {
          "description": "m2 shared with the rooms already placed",
          "title": "Overlap",
          "type": "number"
        },
        "width_diff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "metres between the two sides of the doorway",
          "title": "Width Diff"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "runner-up cost minus this cost; small means the placement is ambiguous",
          "title": "Margin"
        }
      },
      "required": [
        "room",
        "angle",
        "shift",
        "host",
        "host_opening",
        "opening",
        "overlap",
        "width_diff",
        "margin"
      ],
      "title": "Placement",
      "type": "object"
    },
    "RoomPlan": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the room's name in the capture (folder or clip name), if known",
          "title": "Name"
        },
        "frame": {
          "default": "capture",
          "description": "capture: coordinates are in the frame shared by the whole capture; room: the room's own local frame, not yet placed relative to the other rooms",
          "enum": [
            "capture",
            "room"
          ],
          "title": "Frame",
          "type": "string"
        },
        "polygon": {
          "description": "counter-clockwise corner points, plan coordinates",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Polygon",
          "type": "array"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "title": "Walls",
          "type": "array"
        },
        "ceiling_height": {
          "$ref": "#/$defs/Measurement"
        },
        "floor_area": {
          "$ref": "#/$defs/Measurement"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "stations": {
          "items": {
            "$ref": "#/$defs/Station"
          },
          "title": "Stations",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "polygon",
        "walls",
        "ceiling_height",
        "floor_area",
        "openings"
      ],
      "title": "RoomPlan",
      "type": "object"
    },
    "Station": {
      "description": "Where the camera stood in the room's frame (a photo, or a place along a video walk).",
      "properties": {
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "height_above_floor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metres",
          "title": "Height Above Floor"
        }
      },
      "required": [
        "position"
      ],
      "title": "Station",
      "type": "object"
    },
    "Stitching": {
      "description": "The rooms as one property: adjacency, placement, overlaps and footprint.",
      "properties": {
        "footprint": {
          "$ref": "#/$defs/Measurement",
          "description": "m2 of floor covered by all placed rooms, overlaps counted once"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "placements": {
          "description": "empty when the rooms were already in one frame",
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "title": "Placements",
          "type": "array"
        },
        "overlaps": {
          "items": {
            "$ref": "#/$defs/Overlap"
          },
          "title": "Overlaps",
          "type": "array"
        },
        "unplaced": {
          "description": "rooms with no doorway that fits anywhere",
          "items": {
            "type": "string"
          },
          "title": "Unplaced",
          "type": "array"
        },
        "drift": {
          "description": "what was done about pose drift, and what it was not",
          "title": "Drift",
          "type": "string"
        }
      },
      "required": [
        "footprint",
        "links",
        "drift"
      ],
      "title": "Stitching",
      "type": "object"
    },
    "Wall": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "length": {
          "$ref": "#/$defs/Measurement"
        },
        "evidence": {
          "description": "wall_points: fitted to LiDAR points on the wall; closure: a straight chord across a gap with no wall points",
          "enum": [
            "wall_points",
            "closure"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "length",
        "evidence"
      ],
      "title": "Wall",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capture": {
      "title": "Capture",
      "type": "string"
    },
    "tier": {
      "enum": [
        "lidar",
        "video",
        "photo"
      ],
      "title": "Tier",
      "type": "string"
    },
    "units": {
      "const": "m",
      "default": "m",
      "title": "Units",
      "type": "string"
    },
    "rooms": {
      "items": {
        "$ref": "#/$defs/RoomPlan"
      },
      "title": "Rooms",
      "type": "array"
    },
    "stitching": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stitching"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    }
  },
  "required": [
    "capture",
    "tier",
    "rooms",
    "diagnostics"
  ],
  "title": "CapturePlan",
  "type": "object"
}
